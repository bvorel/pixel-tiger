{
  "h1": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h1}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "-1px",
      "lineHeight": "110%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "h2": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h2}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "-1px",
      "lineHeight": "110%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "h3": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h3}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "-1px",
      "lineHeight": "110%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "h4": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h4}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "-0.5px",
      "lineHeight": "110%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
