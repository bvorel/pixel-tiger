      "lineHeight": "140%",
      "textTransform": "none",
      "textDecoration": "none"
    }
  },
  "btn": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{btn.font-family}",
      "fontSize": "{btn.font-size}",
      "fontWeight": "{btn.font-weight}",
      "letterSpacing": "0.75px",
      "lineHeight": "100%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "nav": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{nav.font-family}",
      "fontSize": "{nav.font-size}",
      "fontWeight": "{nav.font-weight}",
      "letterSpacing": "0.75px",
