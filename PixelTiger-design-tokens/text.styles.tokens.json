    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h5}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "-0.5px",
      "lineHeight": "120%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "h6": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{heading.font-family}",
      "fontSize": "{font-size.h6}",
      "fontWeight": "{heading.font-weight}",
      "letterSpacing": "0px",
      "lineHeight": "120%",
      "textTransform": "uppercase",
      "textDecoration": "none"
    }
  },
  "p": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{paragraph.font-family}",
      "fontSize": "{font-size.p}",
      "fontWeight": "{paragraph.default-font-weight}",
      "letterSpacing": "0px",
      "lineHeight": "140%",
      "textTransform": "none",
      "textDecoration": "none"
    }
  },
  "a": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{paragraph.font-family}",
      "fontSize": "{font-size.p}",
      "fontWeight": "{paragraph.default-font-weight}",
      "letterSpacing": "0px",
      "lineHeight": "140%",
      "textTransform": "none",
      "textDecoration": "underline"
    }
  },
  "p .small": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{paragraph.font-family}",
      "fontSize": "{font-size.p-small}",
      "fontWeight": "{paragraph.default-font-weight}",
      "letterSpacing": "0px",
      "lineHeight": "140%",
      "textTransform": "none",
      "textDecoration": "none"
    }
  },
  "p .large": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{paragraph.font-family}",
      "fontSize": "{font-size.p-large}",
      "fontWeight": "{paragraph.default-font-weight}",
      "letterSpacing": "0px",
      "lineHeight": "140%",
      "textTransform": "none",
      "textDecoration": "none"
    }
